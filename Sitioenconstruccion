<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SITIO EN CONSTRUCCIÓN | WebGL Experience</title>
    <style>
        /* Estilos base */
        body {
            margin: 0;
            padding: 0;
            overflow: hidden; /* Importante para el canvas WebGL */
            background-color: #050a1a;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            user-select: none;
        }

        /* Canvas de Three.js */
        #webgl-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Contenedor de la interfaz superpuesta */
        .ui-container {
            position: relative;
            z-index: 10;
            text-align: center;
            padding: 40px;
            background: rgba(10, 20, 40, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Títulos y texto */
        h1 {
            font-size: 3.5rem;
            margin: 0 0 10px 0;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            background: linear-gradient(90deg, #60efff, #fff, #ff7eeb);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 15px rgba(100, 255, 255, 0.5);
        }

        p.subtitulo {
            font-size: 1.3rem;
            color: #a0aec0;
            font-weight: 300;
            margin: 0 0 40px 0;
            letter-spacing: 0.05em;
        }

        /* Barras de progreso futuristas */
        .progress-bar {
            width: 300px;
            height: 6px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 3px;
            overflow: hidden;
            margin: 0 auto 20px auto;
            border: 1px solid rgba(100, 255, 255, 0.2);
        }

        .progress-fill {
            height: 100%;
            width: 75%; /* Simulación de carga */
            background: linear-gradient(90deg, #60efff, #0072ff);
            box-shadow: 0 0 15px #60efff;
            animation: pulse-glow 2s infinite ease-in-out;
        }

        /* Efecto de pulso en el resplandor */
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 10px #60efff, 0 0 20px rgba(0, 114, 255, 0.3); }
            50% { box-shadow: 0 0 20px #fff, 0 0 30px rgba(0, 114, 255, 0.6); }
        }

        /* Botón de acción con efecto glitch sutil */
        .btn-status {
            display: inline-block;
            padding: 12px 30px;
            border: 2px solid #60efff;
            color: #60efff;
            text-decoration: none;
            text-transform: uppercase;
            font-weight: bold;
            font-size: 0.9rem;
            letter-spacing: 0.1em;
            border-radius: 5px;
            transition: all 0.3s ease;
            position: relative;
        }

        .btn-status:hover {
            background: #60efff;
            color: #050a1a;
            box-shadow: 0 0 25px rgba(96, 239, 255, 0.8);
        }
    </style>
</head>
<body>

    <canvas id="webgl-canvas"></canvas>

    <div class="ui-container">
        <h1>Bajo Construcción</h1>
        <p class="subtitulo">Estamos tejiendo el futuro digital. Vuelve pronto.</p>
        
        <div class="progress-bar">
            <div class="progress-fill"></div>
        </div>
        
        <a href="#" class="btn-status">Verificar Estado del Sistema</a>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.9.1/gsap.min.js"></script>

    <script id="vertexShader" type="x-shader/x-vertex">
        varying vec2 vUv;
        varying vec3 vNormal;
        varying vec3 vViewPosition;
        uniform float uTime;

        void main() {
            vUv = uv;
            vNormal = normalize(normalMatrix * normal);
            
            // Un pequeño efecto de desplazamiento por ruido
            vec3 pos = position;
            pos.x += sin(pos.y * 10.0 + uTime) * 0.01;
            pos.z += cos(pos.x * 10.0 + uTime) * 0.01;

            vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
            vViewPosition = -mvPosition.xyz;
            gl_Position = projectionMatrix * mvPosition;
        }
    </script>

    <script id="fragmentShader" type="x-shader/x-fragment">
        varying vec2 vUv;
        varying vec3 vNormal;
        varying vec3 vViewPosition;
        uniform float uTime;
        uniform vec2 uMouse;

        void main() {
            // Un efecto de Fresnel para el resplandor del borde
            vec3 normal = normalize(vNormal);
            vec3 viewDir = normalize(vViewPosition);
            float fresnel = pow(1.0 - dot(normal, viewDir), 3.0);

            // Colores dinámicos basados en el tiempo y el ratón
            vec3 colorA = vec3(0.37, 0.93, 1.0); // Cian cian (#60efff)
            vec3 colorB = vec3(1.0, 0.49, 0.92); // Rosa neón (#ff7eeb)
            
            // Mezcla de colores en el patrón
            vec3 baseColor = mix(colorA, colorB, sin(uTime * 0.5 + vUv.x * 3.14) * 0.5 + 0.5);
            
            // Añadir patrón de ruido/rayas futuristas
            float pattern = sin(vUv.x * 20.0 + uTime * 2.0) * cos(vUv.y * 20.0 - uTime * 2.0);
            baseColor += vec3(pattern * 0.1);

            // Reacción al ratón
            float distToMouse = distance(vUv, (uMouse + 1.0) / 2.0);
            float mouseGlow = 1.0 / (distToMouse * 20.0 + 1.0);
            baseColor += colorA * mouseGlow * fresnel;

            // Combinar todo con Fresnel
            vec3 finalColor = baseColor * fresnel;
            
            // Efecto "glow" adicional
            gl_FragColor = vec4(finalColor + fresnel * 0.8, fresnel + 0.2);
        }
    </script>

    <script>
        // Lógica de Three.js
        const canvas = document.getElementById('webgl-canvas');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.setSize(window.innerWidth, window.innerHeight);

        // Geometría del núcleo (una esfera torcida o "knot")
        const geometry = new THREE.TorusKnotGeometry(1.2, 0.3, 200, 32);

        // Uniforms para los shaders
        const uniforms = {
            uTime: { value: 0 },
            uMouse: { value: new THREE.Vector2(0, 0) }
        };

        // Material personalizado usando los shaders HTML
        const material = new THREE.ShaderMaterial({
            vertexShader: document.getElementById('vertexShader').textContent,
            fragmentShader: document.getElementById('fragmentShader').textContent,
            uniforms: uniforms,
            wireframe: true,
            transparent: true,
            blending: THREE.AdditiveBlending
        });

        // Crear la malla y añadirla a la escena
        const coreMesh = new THREE.Mesh(geometry, material);
        scene.add(coreMesh);

        // Posicionar la cámara
        camera.position.z = 5;

        // Gestión del movimiento del ratón
        window.addEventListener('mousemove', (event) => {
            // Normalizar las coordenadas del ratón (-1 a 1)
            const x = (event.clientX / window.innerWidth) * 2 - 1;
            const y = -(event.clientY / window.innerHeight) * 2 + 1;
            
            // Actualizar uniforms y animar rotación con GSAP para suavidad
            gsap.to(uniforms.uMouse.value, { x: x, y: y, duration: 0.5 });
            gsap.to(coreMesh.rotation, { x: y * 0.5, y: x * 0.5, duration: 1 });
        });

        // Gestión del cambio de tamaño de ventana
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Bucle de animación
        const clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            
            // Actualizar el tiempo para animar los shaders
            uniforms.uTime.value = clock.getElapsedTime();
            
            // Rotación base automática
            coreMesh.rotation.y += 0.002;
            
            renderer.render(scene, camera);
        }

        animate();
    </script>
</body>
</html>
